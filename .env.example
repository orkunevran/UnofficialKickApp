# Unofficial Kick App — environment configuration.
# Copy to .env and customize:  cp .env.example .env
# Every value below is the built-in default; uncomment/edit to override.
# All variables are optional — the server runs with sensible defaults.

# ── Application ───────────────────────────────────────────────────────────
DEBUG=False
PORT=8081
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT_JSON=False                # True = structured JSON logs (for aggregation)
DEFAULT_LANGUAGE_CODE=en             # default featured-stream language
MAX_JSON_BODY_BYTES=16384            # maximum Chromecast/control JSON body
RATE_LIMIT_REQUESTS_PER_SECOND=50    # per-client token-bucket refill rate
RATE_LIMIT_BURST=100                 # per-client burst capacity

# Featured-stream language options (JSON array). Optional; defaults to en/tr/es/de/fr/ru.
# FEATURED_LANGUAGES=[{"code":"en","name":"English"},{"code":"tr","name":"Turkish"}]

# ── Kick upstream endpoints ───────────────────────────────────────────────
KICK_API_BASE_URL=https://kick.com/api/v2/channels/
KICK_FEATURED_LIVESTREAMS_URL=https://kick.com/stream/featured-livestreams/
KICK_ALL_LIVESTREAMS_URL=https://kick.com/stream/livestreams/
KICK_MAX_RESPONSE_BYTES=4194304      # maximum upstream API/HTML/JS response
KICK_MAX_PLAYLIST_BYTES=1048576      # maximum proxied HLS master playlist

# ── Cache (seconds) ───────────────────────────────────────────────────────
CACHE_MAX_SIZE=2000                  # entries before LRU eviction
LIVE_CACHE_DURATION_SECONDS=60       # fresh TTL for /play
LIVE_STALE_TTL_SECONDS=120           # stale-while-revalidate window for /play
VOD_CACHE_DURATION_SECONDS=300
FEATURED_CACHE_DURATION_SECONDS=120  # fresh TTL for featured
FEATURED_STALE_TTL_SECONDS=3600      # stale window for featured
SEARCH_CACHE_DURATION_SECONDS=30
AVATAR_CACHE_DURATION_SECONDS=604800 # 7 days
VIEWER_CACHE_DURATION_SECONDS=30
NEGATIVE_CACHE_DURATION_SECONDS=10   # short TTL for 404s
DVR_SOURCE_CACHE_DURATION_SECONDS=600 # live-rewind recording URL (stable per broadcast)
DVR_PLAYLIST_CACHE_DURATION_SECONDS=5 # live-rewind playlist refresh cadence, used
                                      # only when the playlist declares no
                                      # EXT-X-TARGETDURATION to derive it from

# ── Concurrency / stale-while-revalidate ──────────────────────────────────
LIVE_INFLIGHT_WAIT_TIMEOUT_SECONDS=5.0
BACKGROUND_REFRESH_MAX_CONCURRENCY=4
BACKGROUND_REFRESH_ACQUIRE_TIMEOUT_SECONDS=0.05
NON_CRITICAL_THREAD_OP_CONCURRENCY=4
REFRESH_BACKOFF_SECONDS=5            # cooldown after a failed background refresh

# ── Circuit breakers ──────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5            # non-critical lane (search/viewers/featured)
CIRCUIT_BREAKER_CRITICAL_FAILURE_THRESHOLD=8   # critical lane (play/vod-by-id)
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ── Security & CORS ───────────────────────────────────────────────────────
SECURITY_HEADERS_ENABLED=True
# CONTROL_AUTH_ENABLED=False         # opt in to token-protected Chromecast control
# CONTROL_TOKEN=                     # required only when CONTROL_AUTH_ENABLED=True
# CORS_ORIGINS=http://localhost:3000           # comma-separated; empty = disabled
# CORS_ALLOW_CREDENTIALS=False

# ── Chromecast ────────────────────────────────────────────────────────────
CHROMECAST_SCAN_TIMEOUT=5
CHROMECAST_SELECT_MAX_RETRIES=2
CHROMECAST_SELECT_RETRY_DELAY=2
CHROMECAST_DEVICE_CACHE_SECONDS=30
CHROMECAST_PERIODIC_SCAN_INTERVAL=90
CHROMECAST_STATUS_UPDATE_TIMEOUT=8.0           # bound a status poll; a hung device past this is dropped (must exceed ~5s)
CHROMECAST_CONNECT_COOLDOWN=20.0               # after a failed/dropped connect, bench the device this long so retries don't hammer it (0 disables)
CHROMECAST_STATE_PATH=.kick_chromecast_cache.json
CHROMECAST_FALLBACK_SCAN_ENABLED=True          # subnet probe when mDNS finds nothing
# CHROMECAST_FALLBACK_SCAN_SUBNETS=192.168.0.0/24,192.168.1.0/24,10.0.0.0/24
CHROMECAST_FALLBACK_SCAN_WORKERS=96
CHROMECAST_FALLBACK_SCAN_PROBE_TIMEOUT=1.5
CHROMECAST_FALLBACK_DEVICE_INFO_TIMEOUT=3.0
