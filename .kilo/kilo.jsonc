{
  "$schema": "https://app.kilo.ai/config.json",
  "watcher": {
    "ignore": [
      ".git/**",
      ".kilo/node_modules/**",
      ".kilo/plans/**",
      ".kilocode/node_modules/**",
      ".pytest_cache/**",
      "__pycache__/**",
      "venv/**",
      ".venv/**",
      "node_modules/**",
      "dist/**",
      "build/**"
    ]
  },
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}
