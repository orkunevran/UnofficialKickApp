# Keep the build context small. NOTE: static/ and templates/ are intentionally
# NOT ignored — they are embedded into the binary via //go:embed at build time.
.git
.gitignore
.env
.env.*
.DS_Store
.kilo
.kilocode
.devcontainer
.vscode
docs
*.md
kick-api.code-workspace

# Local build artifacts (the image builds the binary itself)
kick-api-arm64
kick-api-amd64
/server
*.test

# Python leftovers from the pre-Go backend, and runtime state — never built in.
venv
data
